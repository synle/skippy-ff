{
  "name": "skippy",
  "version": "0.30.0",
  "description": "Auto-skip intros, recaps, and credits on Crunchyroll, Disney+, and Apple TV.",
  "homepage": "https://github.com/synle/skippy-ff",
  "bugs": {
    "url": "https://github.com/synle/skippy-ff/issues"
  },
  "license": "ISC",
  "author": "Sy Le",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synle/skippy-ff.git"
  },
  "type": "module",
  "scripts": {
    "dev": "npm run build:types && vite build --watch",
    "build": "npm run build:types && vite build",
    "build:types": "tsc",
    "bundle": "node scripts/bundle.js",
    "package": "npm run build && npm run bundle",
    "package-syle": "npm run package",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "format": "oxfmt --write .",
    "validate": "npm test && npm run lint && npm run build && npm run format",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@vitest/coverage-v8": "^4.1.5",
    "archiver": "^7.0.1",
    "eslint": "^9.39.4",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.61.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "vitest": "^4.1.5"
  },
  "volta": {
    "node": "20.19.1"
  }
}
